          'status',
          'data',
          'truncated',
          'text',
          'redacted',
          'note',
        ]),
        'type': 'object',
      }),
      'title': 'Read a Paperless API path',
    }),
    dict({
      '_meta': dict({
        'fastmcp': dict({
          'tags': list([
            'mail',
          ]),
        }),
      }),
      'annotations': dict({
        'destructiveHint': True,
        'idempotentHint': False,
        'openWorldHint': True,
        'readOnlyHint': False,
        'title': 'Fetch mail now',
      }),
      'description': '''
        Fetch the mail of an account now instead of at the next scheduled run (every 10 minutes).
        
        Paperless connects to the mail server in the background, imports documents from the mails
        that the account's enabled rules match, and then runs each rule's action on those mails ON
        THE MAIL SERVER: it can mark, flag or tag them, move them to another folder or DELETE them,
        and this server cannot undo that. Without confirm a dialog, or an error for you to show the
        user, first lists what each enabled rule would do (see confirm). The result only says the fetch
        was queued: follow the outcome with list_processed_mail and the Paperless task list.
      ''',
      'inputSchema': dict({
        'additionalProperties': False,
        'properties': dict({
          'account_id': dict({
            'description': 'Mail account id, from list_mail_accounts.',
            'minimum': 1,
            'type': 'integer',
          }),
          'confirm': dict({
            'default': False,
            'description': 'Must be true to go ahead at once. Without it a client that can show dialogs asks the user, and the tool runs only if they accept; with any other nothing changes and the error says what would happen. Describe that to the user and pass true only once they agree, or if they already asked for exactly this.',
            'type': 'boolean',
          }),
        }),
        'required': list([
          'account_id',
        ]),
        'type': 'object',
      }),
      'name': 'process_mail_account',
      'outputSchema': dict({
