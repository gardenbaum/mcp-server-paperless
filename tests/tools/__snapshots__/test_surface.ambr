      }),
      'annotations': dict({
        'destructiveHint': True,
        'idempotentHint': True,
        'openWorldHint': False,
        'readOnlyHint': False,
        'title': 'Delete document version',
      }),
      'description': '''
        Delete one version of a document by moving it to the Paperless trash.
        
        Without confirm a dialog, or an error for you to show the user, first names the version and
        what the document shows afterwards (see confirm). If it is the newest version, the document's
        file and text revert to the version before it. The root version (the original upload) cannot be
        deleted this way: delete the whole document with delete_document. The trash keeps the version
        until it is emptied; restore it in the Paperless web UI or with restore_from_trash if the trash
        toolset is enabled.
        Needs the permission to delete documents, and the user must own the document, be a superuser,
        or the document must be unowned (a change grant is not enough).
      ''',
      'inputSchema': dict({
        'additionalProperties': False,
        'properties': dict({
          'confirm': dict({
            'default': False,
            'description': 'Must be true to go ahead at once. Without it a client that can show dialogs asks the user, and the tool runs only if they accept; with any other nothing changes and the error says what would happen. Describe that to the user and pass true only once they agree, or if they already asked for exactly this.',
            'type': 'boolean',
          }),
          'document_id': dict({
            'description': 'Document id, from search_documents.',
            'type': 'integer',
          }),
          'version_id': dict({
            'description': "Version id, from list_document_versions (the root's is the document's).",
            'type': 'integer',
          }),
        }),
        'required': list([
          'document_id',
          'version_id',
        ]),
        'type': 'object',
      }),
      'name': 'delete_document_version',
      'outputSchema': dict({
