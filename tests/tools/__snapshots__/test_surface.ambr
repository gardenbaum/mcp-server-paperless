                              'anyOf': list([
                                dict({
                                  'type': 'integer',
                                }),
                                dict({
                                  'type': 'null',
                                }),
                              ]),
                              'default': None,
                              'description': "The later version with the file; null: the document's own.",
                            }),
                            'web_url': dict({
                              'anyOf': list([
                                dict({
                                  'type': 'string',
                                }),
                                dict({
                                  'type': 'null',
                                }),
                              ]),
                              'default': None,
                              'description': 'Link to the document; null in the trash.',
                            }),
                          }),
                          'required': list([
                            'document_id',
                            'title',
