                'rule_id': dict({
                  'type': 'integer',
                }),
                'status': dict({
                  'description': "SUCCESS, FAILED (the rule's action did not run) or PROCESSED_WO_CONSUMPTION (nothing to import, no action).",
                  'type': 'string',
                }),
                'subject': dict({
                  'type': 'string',
                }),
                'uid': dict({
                  'description': "The mail's number in the folder on the mail server.",
                  'type': 'string',
                }),
              }),
              'required': list([
                'id',
                'rule_id',
                'subject',
                'folder',
                'uid',
                'received',
                'processed',
                'status',
                'error',
              ]),
              'type': 'object',
            }),
            'type': 'array',
