          }),
          'wait_seconds': dict({
            'default': 0,
            'description': 'Wait up to this many seconds for the tasks Paperless starts and return their outcome; more than 30 is cut to 30. 0 returns at once with the task ids; follow them with get_task.',
            'minimum': 0,
            'type': 'integer',
          }),
        }),
        'required': list([
          'document_ids',
          'degrees',
        ]),
        'type': 'object',
      }),
