              dict({
                'type': 'boolean',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Whether the mail is read now.',
          }),
          'received': dict({
            'anyOf': list([
              dict({
                'format': 'date-time',
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
