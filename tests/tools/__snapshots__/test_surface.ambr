      'annotations': dict({
        'destructiveHint': True,
        'idempotentHint': False,
        'openWorldHint': False,
        'readOnlyHint': False,
        'title': 'Bulk edit taxonomy',
      }),
      'description': '''
        Delete many tags, correspondents, document types or storage paths, or set who owns them
        and who may view or change them.
        
        dry_run=true previews; without confirm a dialog, or an error for you to show the user, first
        describes the effect (see confirm). A delete is final (taxonomy has no trash): documents lose
        the reference, and deleting a tag deletes its child tags too (Paperless refuses the deletion if
        it would take child tags of other users). set_permissions without merge replaces all grants
        with the lists you give (a list left out becomes empty); with merge it adds to them, and merge
        cannot set an owner. A change grant includes view. Users and groups by name or id. Custom
        fields are not supported. Paperless checks every object first: if you may not change one, none
        changes (you need the permission and must own it, or it must have no owner). The permissions
        toolset's set_permissions also sets permissions and covers documents too; this tool's
        set_permissions operation empties the lists you leave out, that tool keeps them.
      ''',
      'inputSchema': dict({
        'additionalProperties': False,
        'properties': dict({
          'confirm': dict({
            'default': False,
            'description': 'Must be true to go ahead at once. Without it a client that can show dialogs asks the user, and the tool runs only if they accept; with any other nothing changes and the error says what would happen. Describe that to the user and pass true only once they agree, or if they already asked for exactly this.',
            'type': 'boolean',
          }),
          'dry_run': dict({
            'default': False,
            'description': 'true returns a preview (how many change, a sample, what changes) and writes nothing; it needs no confirm. Do it first.',
            'type': 'boolean',
          }),
          'items': dict({
            'description': 'Names or ids of the objects, at most 100; see list_taxonomy.',
            'items': dict({
              'anyOf': list([
                dict({
                  'type': 'string',
                }),
                dict({
                  'type': 'integer',
                }),
              ]),
            }),
            'maxItems': 100,
            'minItems': 1,
            'type': 'array',
          }),
          'kind': dict({
            'description': 'What the objects are: tag, correspondent, document_type, storage_path.',
            'enum': list([
              'tag',
              'correspondent',
              'document_type',
              'storage_path',
            ]),
            'type': 'string',
          }),
          'operation': dict({
            'description': 'delete, or set_permissions (owner, and who may view or change).',
            'oneOf': list([
