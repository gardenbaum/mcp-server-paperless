                          'description': 'A document, or one version of it, that holds the same file.',
                          'properties': dict({
                            'deleted_at': dict({
                              'anyOf': list([
                                dict({
                                  'format': 'date-time',
                                  'type': 'string',
                                }),
                                dict({
