          'truncated': dict({
            'description': 'True if the body was too long: see text and note.',
            'type': 'boolean',
          }),
        }),
        'required': list([
          'path',
          'status',
          'data',
          'truncated',
          'text',
          'redacted',
          'note',
        ]),
        'type': 'object',
      }),
      'title': 'Read a Paperless API path',
    }),
    dict({
