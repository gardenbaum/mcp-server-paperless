          'groups': dict({
            'items': dict({
              'description': 'A Paperless user group as a compact row (no permission list).',
              'properties': dict({
                'id': dict({
                  'type': 'integer',
                }),
                'name': dict({
                  'type': 'string',
                }),
              }),
              'required': list([
