        'title': 'Merge documents as versions',
      }),
      'description': '''
        Merge documents into another document as its newest versions.
        
        The merged documents vanish for good (not even into the trash): their titles, tags,
        correspondents, notes and other metadata are lost and only their files stay, as versions of
        the root document, which keeps its own metadata. Without confirm a dialog, or an error for you
        to show the user, first names the documents, what would happen and which files Paperless cannot
        find (see confirm). Documents that already have versions of their own cannot be merged in. Needs
        the permissions to change and to delete documents, and the user must own every document (or be a
        superuser, or the documents must be unowned); a change grant is not enough.
      ''',
      'inputSchema': dict({
        'additionalProperties': False,
        'properties': dict({
          'confirm': dict({
            'default': False,
            'description': 'Must be true to go ahead at once. Without it a client that can show dialogs asks the user, and the tool runs only if they accept; with any other nothing changes and the error says what would happen. Describe that to the user and pass true only once they agree, or if they already asked for exactly this.',
            'type': 'boolean',
          }),
          'label': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Version label (at most 64 characters) for the new version; only when exactly one document is merged.',
          }),
          'root_document_id': dict({
            'description': 'The document that keeps its identity and gets the new versions.',
            'type': 'integer',
          }),
          'source_document_ids': dict({
            'description': 'The documents whose files become versions of the root, in this order (the last one newest); at most 20, none with versions of its own.',
            'items': dict({
              'type': 'integer',
            }),
            'type': 'array',
          }),
        }),
        'required': list([
          'root_document_id',
          'source_document_ids',
        ]),
        'type': 'object',
      }),
      'name': 'merge_documents_as_versions',
      'outputSchema': dict({
        'description': 'Documents that were merged into another document as its newest versions.',
        'properties': dict({
          'document_id': dict({
            'description': 'The document that now holds the versions.',
            'type': 'integer',
          }),
          'merged_document_ids': dict({
            'description': 'The documents that were merged in; they no longer exist on their own.',
            'items': dict({
              'type': 'integer',
            }),
            'type': 'array',
          }),
          'message': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
