        'openWorldHint': False,
        'readOnlyHint': False,
        'title': 'Edit PDF',
      }),
      'description': '''
        Build PDF files from the pages of one document: pick, reorder, rotate and group pages.
        
        The general form of split_document, delete_pages and rotate_documents. With output
        new_document (the default) the original stays and every output file becomes a new document
        with the title and metadata of the original. new_version needs a single output file and
        makes it the file the document shows; if it leaves pages out, that needs confirm, as does
        replace_original (new documents, and the original moves to the Paperless trash:
        restore_from_trash of the trash toolset, or the web UI, restores it). Without it a dialog,
        or an error for you to show the user, first says what would happen (see confirm). The
        original is trashed last, by this server, once everything was checked; otherwise it stays
        and next names the calls that finish the work: look there before repeating the call. Page
        numbers are checked against the page count of the file that is read. Needs the permission to
        change documents (and to add them for new documents) and ownership of the document (or no
        owner; a change grant is not enough).
      ''',
      'inputSchema': dict({
        'additionalProperties': False,
        'properties': dict({
          'confirm': dict({
            'default': False,
            'description': 'Must be true to go ahead at once. Without it a client that can show dialogs asks the user, and the tool runs only if they accept; with any other nothing changes and the error says what would happen. Describe that to the user and pass true only once they agree, or if they already asked for exactly this.',
            'type': 'boolean',
          }),
          'document_id': dict({
            'description': 'Document id, from search_documents.',
            'type': 'integer',
          }),
          'dry_run': dict({
            'default': False,
            'description': 'true checks everything and returns the plan; nothing is started.',
            'type': 'boolean',
          }),
          'keep_metadata': dict({
            'default': True,
            'description': 'false: new documents take no title, tags or other metadata over.',
            'type': 'boolean',
          }),
          'output': dict({
            'default': 'new_document',
            'description': 'Where the result goes: new_document (the original stays untouched), new_version (the same document shows the new file; the older version stays) or replace_original (a new document, and the original moves to the Paperless trash once the new one was checked).',
            'enum': list([
              'new_document',
              'new_version',
              'replace_original',
            ]),
            'type': 'string',
          }),
          'pages': dict({
            'description': 'The pages of the result in order. Each entry names the source page (from 1), how far to turn it clockwise (rotate: 0, 90, 180, 270) and which output file it goes to (document: 0, 1, 2 ... without gaps). A page may appear twice.',
            'items': dict({
              'description': '''
                One page of an edited file: which page of the source, turned how far, into which file.
                
                Attributes:
                    page: The page of the source file, counted from 1.
                    rotate: Degrees clockwise added to the page (a multiple of 90, negative turns back).
                    document: The number of the output file the page goes to, from 0; pages keep the order
                        they are listed in within their file.
              ''',
              'properties': dict({
                'document': dict({
                  'default': 0,
                  'description': 'Number of the output file this page goes to, from 0 without gaps; pages keep the order they are listed in within their file.',
                  'type': 'integer',
                }),
                'page': dict({
                  'description': 'Page of the source file, counted from 1.',
                  'type': 'integer',
                }),
                'rotate': dict({
                  'default': 0,
                  'description': 'Degrees to turn the page clockwise: 0, 90, 180 or 270 (-90 turns back).',
                  'type': 'integer',
                }),
              }),
              'required': list([
                'page',
              ]),
              'type': 'object',
            }),
            'maxItems': 500,
            'minItems': 1,
            'type': 'array',
          }),
          'version_id': dict({
            'anyOf': list([
              dict({
                'type': 'integer',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Version whose file is read (get_document with include versions); left out: the newest.',
          }),
          'wait_seconds': dict({
            'anyOf': list([
              dict({
                'minimum': 0,
                'type': 'integer',
