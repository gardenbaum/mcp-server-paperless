                          'deleted_at': dict({
                            'anyOf': list([
                              dict({
                                'format': 'date-time',
                                'type': 'string',
                              }),
                              dict({
                                'type': 'null',
                              }),
                            ]),
                            'default': None,
                          }),
                          'document_id': dict({
                            'type': 'integer',
                          }),
                          'in_trash': dict({
                            'default': False,
                            'type': 'boolean',
                          }),
                          'title': dict({
                            'anyOf': list([
                              dict({
                                'type': 'string',
                              }),
