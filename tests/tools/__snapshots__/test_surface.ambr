        }),
      }),
      'annotations': dict({
        'idempotentHint': True,
        'openWorldHint': False,
        'readOnlyHint': True,
        'title': 'Download documents as a ZIP archive',
      }),
      'description': "Get the files of several documents as one ZIP archive, attached as an embedded resource. The archive comes as MCP content after a JSON report (file name, size, delivered), not saved on the server's machine. An archive over the server's download limit (512 KiB unless the administrator changed it) is not attached: delivered is false and the note says what to do. With offset you get one part of an archive of up to 2 GiB: start with offset=0, then repeat the arguments that next in the report names until next_offset is null, append the parts and compare the SHA-256 of the whole with checksum. Paperless builds the archive anew for every part; if a document changed in between, start again. The archive holds the newest version of each document. The whole request fails if one document is hidden from the user. Use download_document for one file.",
      'inputSchema': dict({
        'additionalProperties': False,
        'properties': dict({
          'checksum': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': "checksum of the first part's report; every later part needs it.",
          }),
          'compression': dict({
            'default': 'none',
            'description': 'ZIP compression.',
            'enum': list([
              'none',
              'deflated',
              'bzip2',
              'lzma',
            ]),
            'type': 'string',
          }),
          'content': dict({
            'default': 'archive',
            'description': 'archive: the searchable PDF/A files (the original where there is none); originals: the files as uploaded; both: originals plus the archive files.',
            'enum': list([
              'archive',
              'originals',
              'both',
            ]),
            'type': 'string',
          }),
          'document_ids': dict({
            'description': 'Document ids from search_documents; at most 100, each once.',
            'items': dict({
              'minimum': 1,
              'type': 'integer',
            }),
            'maxItems': 100,
            'minItems': 1,
            'type': 'array',
          }),
          'follow_formatting': dict({
            'default': False,
            'description': 'Name the files by the storage path format of each document.',
            'type': 'boolean',
          }),
          'max_bytes': dict({
            'anyOf': list([
              dict({
                'minimum': 1,
                'type': 'integer',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Most bytes of the part; at most (and by default) the download limit.',
          }),
          'offset': dict({
            'anyOf': list([
              dict({
                'minimum': 0,
                'type': 'integer',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Read one part from this byte on; 0 for the first. Default: whole file.',
          }),
        }),
        'required': list([
          'document_ids',
        ]),
        'type': 'object',
      }),
      'name': 'bulk_download',
      'title': 'Download documents as a ZIP archive',
    }),
