                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Whether it is flagged now.',
          }),
          'is_read': dict({
            'anyOf': list([
              dict({
                'type': 'boolean',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Whether the mail is read now.',
          }),
          'received': dict({
            'anyOf': list([
              dict({
                'format': 'date-time',
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'When the mail arrived.',
          }),
          'recipient': dict({
            'anyOf': list([
              dict({
                'maxLength': 2000,
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': "The mail's To.",
          }),
          'rule_id': dict({
            'anyOf': list([
              dict({
                'minimum': 1,
                'type': 'integer',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Only this rule of the account; default: all.',
          }),
          'sender': dict({
            'anyOf': list([
              dict({
                'maxLength': 2000,
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': "The mail's From, name and address.",
          }),
          'subject': dict({
            'anyOf': list([
              dict({
                'maxLength': 2000,
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': "The mail's whole subject; finds its records too.",
          }),
        }),
        'required': list([
          'account_id',
        ]),
        'type': 'object',
      }),
      'name': 'explain_mail_import',
      'outputSchema': dict({
        'description': 'Why a mail may not have been imported, from what Paperless has stored. No dry run.',
