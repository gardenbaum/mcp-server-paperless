          'username': dict({
            'anyOf': list([
              dict({
                'maxLength': 256,
                'minLength': 1,
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'New login name.',
          }),
        }),
        'required': list([
          'account_id',
        ]),
        'type': 'object',
