              }),
              dict({
                'type': 'null',
              }),
            ]),
            'description': 'The next page, null on the last one.',
          }),
          'notice': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'What the filter left out and how to reach it.',
          }),
          'page': dict({
            'type': 'integer',
          }),
          'scanned': dict({
            'anyOf': list([
              dict({
                'type': 'integer',
              }),
