            'description': "The mail's To.",
          }),
          'rule_id': dict({
            'anyOf': list([
              dict({
                'minimum': 1,
                'type': 'integer',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Only this rule of the account; default: all.',
          }),
          'sender': dict({
            'anyOf': list([
              dict({
                'maxLength': 2000,
                'type': 'string',
              }),
              dict({
