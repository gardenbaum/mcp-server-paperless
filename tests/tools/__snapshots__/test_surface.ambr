              }),
            ]),
            'default': None,
            'description': "The mail's From, name and address.",
          }),
          'subject': dict({
            'anyOf': list([
              dict({
                'maxLength': 2000,
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': "The mail's whole subject; finds its records too.",
          }),
        }),
        'required': list([
          'account_id',
        ]),
        'type': 'object',
      }),
