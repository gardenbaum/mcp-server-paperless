      }),
      'description': '''
        List the mails Paperless handled, as compact rows.
        
        Each row has the subject, folder, uid, when it arrived and was processed, the rule, and the
        status (a failed one with a short error; get_processed_mail has all of it). Use it to check a
        fetch or to find why a mail did not become a document. count is the total; pass next_page as
        page to see more.
      ''',
      'inputSchema': dict({
        'additionalProperties': False,
        'properties': dict({
          'ordering': dict({
            'default': '-processed',
            'description': 'By when it was processed or received; - is newest first.',
            'enum': list([
              '-processed',
              'processed',
              '-received',
              'received',
            ]),
            'type': 'string',
          }),
          'page': dict({
            'default': 1,
            'description': 'Page number, from 1.',
            'minimum': 1,
            'type': 'integer',
          }),
          'page_size': dict({
            'default': 25,
            'description': 'Rows per page, at most 100.',
            'maximum': 100,
            'minimum': 1,
            'type': 'integer',
          }),
          'rule_id': dict({
            'anyOf': list([
              dict({
                'minimum': 1,
                'type': 'integer',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Only mail handled by this rule; default: all.',
          }),
          'status': dict({
            'anyOf': list([
              dict({
                'enum': list([
                  'SUCCESS',
                  'FAILED',
                  'PROCESSED_WO_CONSUMPTION',
                ]),
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Only this status (PROCESSED_WO_CONSUMPTION: nothing to import).',
          }),
        }),
        'type': 'object',
      }),
      'name': 'list_processed_mail',
      'outputSchema': dict({
        'description': 'One page of processed mail.',
