        'properties': dict({
          'current_version_id': dict({
            'description': 'The newest version: the file downloads and the text show.',
            'type': 'integer',
          }),
          'document_id': dict({
            'type': 'integer',
          }),
          'title': dict({
            'type': 'string',
          }),
          'versions': dict({
            'items': dict({
              'description': 'One file version of a document.',
              'properties': dict({
                'added': dict({
                  'format': 'date-time',
                  'type': 'string',
