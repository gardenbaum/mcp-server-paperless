        'destructiveHint': True,
        'idempotentHint': False,
        'openWorldHint': False,
        'readOnlyHint': False,
        'title': 'Delete pages',
      }),
      'description': '''
        Delete pages from a PDF by making a file without them.
        
        By default (new_version) the document then shows the shorter file and the older version with
        all pages stays until it is deleted, but pages vanish from what the document shows, so this
        needs confirm; so does replace_original (a new document without the pages, the original
        moves to the Paperless trash: restore_from_trash of the trash toolset, or the web UI,
        restores it). With new_document nothing existing changes and no confirm is needed. Without
        it a dialog, or an error for you to show the user, first names the pages and what would
        happen (see confirm). An original is trashed last, by this server, once the new document was
        checked; otherwise it stays and next names the calls that finish the work: look there before
        repeating the call. Page ranges are checked against the page count of the file that is read.
        Needs the permission to change documents (and to add them for a new document) and ownership
        of the document (or no owner; a change grant is not enough).
      ''',
      'inputSchema': dict({
        'additionalProperties': False,
        'properties': dict({
          'confirm': dict({
            'default': False,
            'description': 'Must be true to go ahead at once. Without it a client that can show dialogs asks the user, and the tool runs only if they accept; with any other nothing changes and the error says what would happen. Describe that to the user and pass true only once they agree, or if they already asked for exactly this.',
            'type': 'boolean',
          }),
          'document_id': dict({
            'description': 'Document id, from search_documents.',
            'type': 'integer',
          }),
          'dry_run': dict({
            'default': False,
            'description': 'true checks everything and returns the plan; nothing is started.',
            'type': 'boolean',
          }),
          'keep_metadata': dict({
            'default': True,
            'description': 'false: new documents take no title, tags or other metadata over.',
            'type': 'boolean',
          }),
          'output': dict({
            'default': 'new_version',
            'description': 'Where the result goes: new_document (the original stays untouched), new_version (the same document shows the new file; the older version stays) or replace_original (a new document, and the original moves to the Paperless trash once the new one was checked).',
            'enum': list([
              'new_document',
              'new_version',
              'replace_original',
            ]),
            'type': 'string',
          }),
          'pages': dict({
            'description': "The pages to delete, counted from 1: pages and ranges separated by commas, e.g. '2' or '1-3,5'. Not every page.",
            'type': 'string',
          }),
          'version_id': dict({
            'anyOf': list([
              dict({
                'type': 'integer',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Version whose file is read (get_document with include versions); left out: the newest.',
          }),
          'wait_seconds': dict({
            'anyOf': list([
              dict({
                'minimum': 0,
                'type': 'integer',
              }),
              dict({
                'type': 'null',
              }),
