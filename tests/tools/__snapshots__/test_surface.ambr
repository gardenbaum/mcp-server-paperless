      'annotations': dict({
        'destructiveHint': True,
        'idempotentHint': False,
        'openWorldHint': False,
        'readOnlyHint': False,
        'title': 'Split document',
      }),
      'description': '''
        Split a PDF into one new document per page range.
        
        The new documents take the title and metadata of the original; part_metadata sets title, type,
        correspondent, date and tags of each part once it exists and was checked. parts says of every
        part how far it is, and in next the calls that finish it. The original stays unless
        output is replace_original: it then moves to the Paperless trash (restore_from_trash of the
        trash toolset, or the web UI, restores it), which needs confirm. Without it a dialog, or an
        error for you to show the user, first names the document and what would happen (see
        confirm). The original is trashed last, by this server, once every part was checked and has its
        metadata; otherwise it stays and next names the calls that finish the work: look there before
        repeating the call. Several files cannot be one version of a document. Page ranges are
        checked against the page count of the file that is read. Needs the permission to change and
        to add documents and ownership of the document (or no owner; a change grant is not enough),
        and for replace_original the permission to delete documents.
      ''',
      'inputSchema': dict({
        'additionalProperties': False,
        'properties': dict({
          'confirm': dict({
            'default': False,
            'description': 'Must be true to go ahead at once. Without it a client that can show dialogs asks the user, and the tool runs only if they accept; with any other nothing changes and the error says what would happen. Describe that to the user and pass true only once they agree, or if they already asked for exactly this.',
            'type': 'boolean',
          }),
          'document_id': dict({
            'description': 'Document id, from search_documents.',
            'type': 'integer',
          }),
          'dry_run': dict({
            'default': False,
            'description': 'true checks everything and returns the plan; nothing is started.',
            'type': 'boolean',
          }),
          'keep_metadata': dict({
            'default': True,
            'description': 'false: new documents take no title, tags or other metadata over.',
            'type': 'boolean',
          }),
          'output': dict({
            'default': 'new_document',
            'description': 'new_document leaves the original; replace_original moves it to the Paperless trash once every part was checked, and needs confirm.',
            'enum': list([
              'new_document',
              'replace_original',
            ]),
            'type': 'string',
          }),
          'part_metadata': dict({
            'anyOf': list([
              dict({
                'items': dict({
                  'additionalProperties': False,
                  'description': '''
                    What a new document of a page operation gets instead of what Paperless copies.
                    
                    Attributes:
                        tags: The whole list; None keeps the copied ones.
                  ''',
                  'properties': dict({
                    'correspondent': dict({
                      'anyOf': list([
                        dict({
                          'anyOf': list([
                            dict({
                              'type': 'string',
                            }),
