                              'type': 'integer',
                            }),
                          ]),
                        }),
                        dict({
                          'type': 'null',
                        }),
                      ]),
                      'default': None,
                      'description': 'Name or id.',
                    }),
                    'created': dict({
                      'anyOf': list([
                        dict({
                          'format': 'date',
                          'type': 'string',
                        }),
                        dict({
                          'type': 'null',
                        }),
                      ]),
                      'default': None,
                      'description': 'YYYY-MM-DD.',
                    }),
                    'document_type': dict({
                      'anyOf': list([
                        dict({
                          'anyOf': list([
                            dict({
                              'type': 'string',
                            }),
                            dict({
                              'type': 'integer',
                            }),
                          ]),
                        }),
                        dict({
                          'type': 'null',
                        }),
                      ]),
                      'default': None,
                      'description': 'Name or id.',
                    }),
                    'tags': dict({
                      'anyOf': list([
                        dict({
                          'items': dict({
                            'anyOf': list([
                              dict({
                                'type': 'string',
                              }),
                              dict({
                                'type': 'integer',
                              }),
                            ]),
                          }),
                          'type': 'array',
                        }),
                        dict({
                          'type': 'null',
                        }),
                      ]),
                      'default': None,
                      'description': 'All its tags (names or ids), also without the inbox tags if not named.',
                    }),
                    'title': dict({
                      'anyOf': list([
                        dict({
                          'type': 'string',
                        }),
                        dict({
                          'type': 'null',
                        }),
                      ]),
                      'default': None,
                      'description': 'At most 128 characters.',
                    }),
                  }),
                  'type': 'object',
                }),
                'maxItems': 20,
                'minItems': 2,
                'type': 'array',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'One entry per part, in their order, of what the part gets instead of the copied metadata. A field left out keeps what is copied; {} changes nothing.',
          }),
          'parts': dict({
            'description': "One page range per new document, e.g. ['1-3', '4,6-8']: pages and ranges separated by commas, '5-' runs to the last page. A page belongs to one part at most; pages in no part are in no new document.",
            'items': dict({
