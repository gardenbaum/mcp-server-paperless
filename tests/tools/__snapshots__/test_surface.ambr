            'minimum': 1,
            'type': 'integer',
          }),
          'page_size': dict({
            'default': 25,
            'description': 'Rows per page, at most 100.',
            'maximum': 100,
            'minimum': 1,
            'type': 'integer',
          }),
        }),
        'type': 'object',
      }),
