              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Deleted on this day (UTC) or later.',
          }),
          'deleted_to': dict({
            'anyOf': list([
              dict({
                'format': 'date',
                'type': 'string',
