      'annotations': dict({
        'destructiveHint': False,
        'idempotentHint': False,
        'openWorldHint': True,
        'readOnlyHint': False,
        'title': 'Create share bundle',
      }),
      'description': '''
        Publish the files of several documents as one ZIP archive under a public link.
        
        ANYONE WHO HAS THE URL can download the archive without logging in, until the bundle expires
        or is deleted with delete_share_bundle. Paperless builds the archive after this returns, so
        the status is usually pending: the URL works once list_share_bundles shows ready. Without
        confirm a dialog, or an error for you to show the user, first names the documents, the files,
        the expiry and what is public (see confirm). Needs the add permission for bundles and documents
        the user can see.
      ''',
      'inputSchema': dict({
        'additionalProperties': False,
        'properties': dict({
          'confirm': dict({
            'default': False,
            'description': 'Must be true to go ahead at once. Without it a client that can show dialogs asks the user, and the tool runs only if they accept; with any other nothing changes and the error says what would happen. Describe that to the user and pass true only once they agree, or if they already asked for exactly this.',
            'type': 'boolean',
          }),
          'document_ids': dict({
            'description': 'Document ids, from search_documents; at most 50, each once.',
            'items': dict({
              'minimum': 1,
              'type': 'integer',
            }),
            'maxItems': 50,
            'minItems': 1,
            'type': 'array',
          }),
          'expires_in_days': dict({
            'anyOf': list([
              dict({
                'maximum': 3650,
                'minimum': 1,
                'type': 'integer',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'It stops working this many days from now; leave out: it never expires.',
          }),
          'file_version': dict({
            'default': 'archive',
            'description': 'archive: the searchable PDF/A Paperless made (the original where there is none); original: the file as it was uploaded.',
            'enum': list([
              'archive',
              'original',
            ]),
            'type': 'string',
          }),
        }),
        'required': list([
          'document_ids',
        ]),
        'type': 'object',
      }),
      'name': 'create_share_bundle',
      'outputSchema': dict({
        'description': 'A share-link bundle: one URL for a ZIP archive of several documents.',
        'properties': dict({
          'built_at': dict({
            'anyOf': list([
              dict({
                'format': 'date-time',
                'type': 'string',
