                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'What the filter left out and how to reach it.',
          }),
          'page': dict({
            'type': 'integer',
          }),
          'scanned': dict({
            'anyOf': list([
              dict({
                'type': 'integer',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'With a filter other than ids: how many entries were looked at.',
