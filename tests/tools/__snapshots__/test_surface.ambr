                      'why',
                    ]),
                    'type': 'object',
                  }),
                  'type': 'array',
                }),
                'name': dict({
                  'type': 'string',
                }),
                'result': dict({
                  'description': 'no: a check says no; ok: nothing found against it, no more than that.',
                  'enum': list([
                    'ok',
