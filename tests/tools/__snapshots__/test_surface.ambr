                'expired': dict({
                  'description': 'Whether it has stopped working already.',
                  'type': 'boolean',
                }),
                'file_version': dict({
                  'enum': list([
                    'archive',
                    'original',
                  ]),
                  'type': 'string',
                }),
                'id': dict({
                  'type': 'integer',
                }),
                'last_error': dict({
                  'anyOf': list([
                    dict({
                      'type': 'string',
                    }),
                    dict({
                      'type': 'null',
                    }),
                  ]),
                  'description': 'Why the last build failed, if it did.',
