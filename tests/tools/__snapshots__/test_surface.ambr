              ]),
              'type': 'object',
            }),
            'type': 'array',
          }),
          'next_page': dict({
            'anyOf': list([
              dict({
                'type': 'integer',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'description': 'The next page, null on the last one.',
          }),
          'page': dict({
            'type': 'integer',
          }),
        }),
        'required': list([
          'count',
          'page',
          'next_page',
          'groups',
        ]),
        'type': 'object',
      }),
      'title': 'List groups',
