                    'type': 'string',
                  }),
                  dict({
                    'type': 'null',
                  }),
                ]),
                'description': 'Null if the user may not see its name.',
              }),
            }),
            'required': list([
              'id',
              'name',
            ]),
            'type': 'object',
          }),
          'status': dict({
            'description': "SUCCESS, FAILED (the rule's action did not run) or PROCESSED_WO_CONSUMPTION (nothing to import, no action).",
            'type': 'string',
          }),
          'subject': dict({
            'type': 'string',
          }),
          'uid': dict({
            'description': "The mail's number in the folder on the mail server.",
            'type': 'string',
          }),
        }),
        'required': list([
          'id',
          'rule',
          'folder',
          'uid',
          'subject',
          'received',
          'processed',
          'status',
          'owner',
          'error',
          'error_from',
          'error_total',
          'error_next',
