    dict({
      '_meta': dict({
        'fastmcp': dict({
          'tags': list([
            'pdf',
          ]),
        }),
      }),
      'annotations': dict({
        'destructiveHint': True,
        'idempotentHint': False,
        'openWorldHint': False,
        'readOnlyHint': False,
        'title': 'Extract pages',
      }),
      'description': '''
        Put pages of a PDF into one new document, and with remove take them out of the document.
        
        The new document takes the title and metadata of the document, or what metadata says. Without
        remove the document stays as it is and no confirm is needed. With remove it then shows a new
        version without the pages, so pages vanish from what it shows (the earlier version with all
        pages stays until it is deleted): this needs confirm. Without it a dialog, or an error for you
        to show the user, first says what would happen (see confirm). The pages are removed last, once
        the new document exists, has these pages and its metadata and nothing changed meanwhile;
        otherwise they stay (original, message) and next names the calls that finish the work: look
        there before repeating the call. Not every page, and only from the newest version. Needs the
        permission to change and to add documents and ownership of the document (or no owner; a change
        grant is not enough).
      ''',
      'inputSchema': dict({
        'additionalProperties': False,
        'properties': dict({
          'confirm': dict({
            'default': False,
            'description': 'Must be true to go ahead at once. Without it a client that can show dialogs asks the user, and the tool runs only if they accept; with any other nothing changes and the error says what would happen. Describe that to the user and pass true only once they agree, or if they already asked for exactly this.',
            'type': 'boolean',
          }),
          'document_id': dict({
            'description': 'Document id, from search_documents.',
            'type': 'integer',
          }),
          'dry_run': dict({
            'default': False,
            'description': 'true checks everything and returns the plan; nothing is started.',
            'type': 'boolean',
          }),
          'keep_metadata': dict({
            'default': True,
            'description': 'false: new documents take no title, tags or other metadata over.',
            'type': 'boolean',
          }),
          'metadata': dict({
            'anyOf': list([
              dict({
                'additionalProperties': False,
                'description': '''
                  What a new document of a page operation gets instead of what Paperless copies.
                  
                  Attributes:
                      tags: The whole list; None keeps the copied ones.
                ''',
                'properties': dict({
                  'correspondent': dict({
                    'anyOf': list([
                      dict({
                        'anyOf': list([
                          dict({
                            'type': 'string',
                          }),
                          dict({
                            'type': 'integer',
                          }),
                        ]),
                      }),
                      dict({
                        'type': 'null',
                      }),
                    ]),
                    'default': None,
                    'description': 'Name or id.',
                  }),
                  'created': dict({
                    'anyOf': list([
                      dict({
                        'format': 'date',
                        'type': 'string',
                      }),
                      dict({
                        'type': 'null',
                      }),
                    ]),
                    'default': None,
                    'description': 'YYYY-MM-DD.',
                  }),
                  'document_type': dict({
                    'anyOf': list([
                      dict({
                        'anyOf': list([
                          dict({
                            'type': 'string',
                          }),
                          dict({
                            'type': 'integer',
                          }),
                        ]),
                      }),
                      dict({
                        'type': 'null',
                      }),
                    ]),
                    'default': None,
                    'description': 'Name or id.',
                  }),
                  'tags': dict({
                    'anyOf': list([
                      dict({
                        'items': dict({
                          'anyOf': list([
                            dict({
                              'type': 'string',
                            }),
                            dict({
                              'type': 'integer',
                            }),
                          ]),
                        }),
                        'type': 'array',
                      }),
                      dict({
                        'type': 'null',
                      }),
                    ]),
                    'default': None,
                    'description': 'All its tags (names or ids), also without the inbox tags if not named.',
                  }),
                  'title': dict({
                    'anyOf': list([
                      dict({
                        'type': 'string',
                      }),
                      dict({
                        'type': 'null',
                      }),
                    ]),
                    'default': None,
                    'description': 'At most 128 characters.',
                  }),
                }),
                'type': 'object',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'What the new document gets instead of the copied metadata.',
          }),
          'pages': dict({
            'description': "The pages of the new document in order, counted from 1: pages and ranges separated by commas, e.g. '2' or '5,1-3'.",
            'type': 'string',
          }),
          'remove': dict({
            'default': False,
            'description': 'true also removes the pages from the document, once the new one was checked. Needs confirm.',
            'type': 'boolean',
          }),
          'version_id': dict({
            'anyOf': list([
              dict({
                'type': 'integer',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Version whose file is read (get_document with include versions); left out: the newest.',
          }),
          'wait_seconds': dict({
            'anyOf': list([
              dict({
                'minimum': 0,
                'type': 'integer',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Seconds to wait for the tasks Paperless starts; more than 30 is cut to 30. Left out: 30 where originals are to be trashed, pages removed or metadata set afterwards, else 0. With 0 the task ids are returned at once and none of that is done.',
          }),
        }),
        'required': list([
          'document_id',
          'pages',
        ]),
        'type': 'object',
      }),
