                      }),
                      'title': dict({
                        'anyOf': list([
                          dict({
                            'type': 'string',
                          }),
                          dict({
                            'type': 'null',
                          }),
                        ]),
                        'description': 'Null if the user may not see the document.',
                      }),
                      'web_url': dict({
                        'description': 'Link to the document in the Paperless web UI.',
                        'type': 'string',
                      }),
                    }),
                    'required': list([
                      'id',
                      'title',
                      'web_url',
                    ]),
                    'type': 'object',
                  }),
                  'type': 'array',
                }),
                'expiration': dict({
                  'anyOf': list([
                    dict({
                      'format': 'date-time',
                      'type': 'string',
                    }),
                    dict({
                      'type': 'null',
                    }),
                  ]),
                  'description': 'When it stops working; null: never.',
