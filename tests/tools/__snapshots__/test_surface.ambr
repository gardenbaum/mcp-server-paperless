          }),
          'ids': dict({
            'anyOf': list([
              dict({
                'items': dict({
                  'minimum': 1,
                  'type': 'integer',
                }),
                'maxItems': 100,
                'minItems': 1,
                'type': 'array',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Only these entry ids.',
          }),
          'kind': dict({
            'anyOf': list([
              dict({
                'enum': list([
                  'document',
                  'version',
                ]),
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'document, or version: a deleted version.',
          }),
          'page': dict({
            'default': 1,
            'description': 'Page number, from 1.',
            'minimum': 1,
            'type': 'integer',
          }),
          'page_size': dict({
            'default': 25,
            'description': 'Entries per page, at most 100.',
            'maximum': 100,
            'minimum': 1,
            'type': 'integer',
          }),
          'title': dict({
            'anyOf': list([
              dict({
                'minLength': 1,
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Part of the title, ignoring case.',
          }),
        }),
        'type': 'object',
      }),
      'name': 'list_trash',
      'outputSchema': dict({
        'description': 'One page of the trash.',
        'properties': dict({
          'count': dict({
            'description': 'How many entries the trash holds, or with a filter: how many match.',
            'type': 'integer',
          }),
          'entries': dict({
            'items': dict({
