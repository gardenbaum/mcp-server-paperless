            'anyOf': list([
              dict({
                'type': 'boolean',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'false: only tasks nobody acknowledged yet.',
          }),
          'page': dict({
            'default': 1,
            'description': 'Page number, from 1.',
            'minimum': 1,
            'type': 'integer',
          }),
          'page_size': dict({
            'default': 25,
            'description': 'Rows per page, at most 100.',
            'maximum': 100,
            'minimum': 1,
            'type': 'integer',
          }),
          'state': dict({
            'anyOf': list([
              dict({
                'enum': list([
                  'pending',
                  'started',
                  'success',
                  'failure',
                  'revoked',
                ]),
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Only tasks in this state, e.g. failure.',
          }),
          'task_type': dict({
            'anyOf': list([
              dict({
                'enum': list([
                  'consume_file',
                  'train_classifier',
                  'sanity_check',
                  'index_optimize',
                  'mail_fetch',
                  'llm_index',
                  'empty_trash',
                  'check_workflows',
                  'bulk_update',
                  'reprocess_document',
                  'build_share_link',
                  'bulk_delete',
                  'apply_ai_suggestions',
                ]),
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Only this kind, e.g. consume_file or sanity_check.',
          }),
        }),
        'type': 'object',
      }),
      'name': 'list_tasks',
      'outputSchema': dict({
        'description': 'One page of tasks, newest first.',
        'properties': dict({
          'count': dict({
            'description': 'How many tasks match in total.',
            'type': 'integer',
          }),
          'next_page': dict({
            'anyOf': list([
              dict({
                'type': 'integer',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'description': 'The next page, null on the last one.',
          }),
          'page': dict({
            'type': 'integer',
          }),
          'tasks': dict({
            'items': dict({
              'description': 'A background task with the database id that acknowledging needs.',
