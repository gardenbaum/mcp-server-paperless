    dict({
      '_meta': dict({
        'fastmcp': dict({
          'tags': list([
            'permissions',
          ]),
        }),
      }),
      'annotations': dict({
        'destructiveHint': True,
        'idempotentHint': True,
        'openWorldHint': False,
        'readOnlyHint': False,
        'title': 'Set permissions',
      }),
      'description': '''
        Share documents, taxonomy objects, mail accounts or mail rules, or hand them over.
        
        Sets who owns the objects and which users and groups may view or change them, by name or id.
        A change grant includes view. Lists you leave out are never touched in either mode, so a
        forgotten list never wipes anything, and unknown users or groups are an error before
        anything is sent. mode merge (default) only adds to the grants; mode replace sets each list
        you give to exactly that list (a changer always keeps view, replace change_users to take
        change away). Granting access cannot be taken back, so every call that changes anything
        needs confirm, in both modes and for owner changes: without it a dialog, or an error for you to
        show the user, first names, per object, who gains and who loses access and what the owner
        change does (see confirm). Objects that already are as asked are left alone and need no
        confirm. Needs to own the objects (or no owner) or be a superuser, plus the permission to
        change the kind. The confirmation says what a change grant on a mail account (its saved password
        can be sent anywhere) or a mail rule gives; a grant on an account is none on its rules. Other
        tools touch permissions too: update_document(owner=) only changes a document's owner alongside
        other edits, and bulk_edit_taxonomy (bulk toolset) sets permissions of taxonomy objects with a
        dry_run preview, and replaces the lists you leave out; this tool also covers documents and keeps
        the lists you leave out. Look up users and groups with
        list_users and list_groups.
      ''',
      'inputSchema': dict({
        'additionalProperties': False,
        'properties': dict({
          'change_groups': dict({
            'anyOf': list([
              dict({
                'items': dict({
                  'anyOf': list([
                    dict({
                      'type': 'string',
                    }),
                    dict({
                      'type': 'integer',
                    }),
                  ]),
                }),
                'type': 'array',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Groups who may change, and so view: names or ids.',
          }),
          'change_users': dict({
            'anyOf': list([
              dict({
                'items': dict({
                  'anyOf': list([
                    dict({
                      'type': 'string',
                    }),
                    dict({
                      'type': 'integer',
                    }),
                  ]),
                }),
                'type': 'array',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Users who may change, and so view: usernames or ids.',
          }),
          'clear_owner': dict({
            'default': False,
            'description': 'true removes the owner: every user with the global permission to view the kind of object can then see it, and every user with the global permission to change it can change it. Needs confirm. Not together with owner.',
            'type': 'boolean',
          }),
          'confirm': dict({
            'default': False,
            'description': 'Must be true to go ahead at once. Without it a client that can show dialogs asks the user, and the tool runs only if they accept; with any other nothing changes and the error says what would happen. Describe that to the user and pass true only once they agree, or if they already asked for exactly this.',
            'type': 'boolean',
          }),
          'items': dict({
            'description': 'The objects, at most 100. Documents: ids from search_documents. Mail accounts and rules: ids from list_mail_accounts and list_mail_rules (mail toolset). Others: names or ids, see list_taxonomy.',
            'items': dict({
              'anyOf': list([
                dict({
                  'type': 'string',
                }),
                dict({
                  'type': 'integer',
                }),
              ]),
            }),
            'maxItems': 100,
            'minItems': 1,
            'type': 'array',
          }),
          'kind': dict({
            'description': 'What the objects are: document, tag, correspondent, document_type, storage_path, mail_account or mail_rule.',
            'enum': list([
              'document',
              'tag',
              'correspondent',
              'document_type',
              'storage_path',
              'mail_account',
              'mail_rule',
            ]),
            'type': 'string',
          }),
          'mode': dict({
            'default': 'merge',
            'description': 'merge (default) adds the given users and groups to the grants the objects have. replace makes each list you give exactly that list (an empty list removes all its grants).',
            'enum': list([
              'merge',
              'replace',
            ]),
            'type': 'string',
          }),
          'owner': dict({
            'anyOf': list([
              dict({
                'anyOf': list([
