        'readOnlyHint': False,
        'title': 'Set document version label',
      }),
      'description': '''
        Set or clear the label of one version of a document, the root version's too.
        
        Labels are free text (e.g. 'signed copy') and only help tell versions apart; nothing else
        changes. Needs the permission to change documents and ownership of the document or a change
        grant on it.
      ''',
      'inputSchema': dict({
        'additionalProperties': False,
        'properties': dict({
          'document_id': dict({
            'description': 'Document id, from search_documents.',
            'type': 'integer',
          }),
          'label': dict({
            'description': 'The new label, at most 64 characters; an empty string clears it.',
            'type': 'string',
          }),
          'version_id': dict({
            'description': "Version id, from list_document_versions (the root's is the document's).",
            'type': 'integer',
          }),
        }),
        'required': list([
          'document_id',
          'version_id',
          'label',
        ]),
        'type': 'object',
      }),
