            'type': 'integer',
          }),
          'document_id': dict({
            'type': 'integer',
          }),
          'message': dict({
            'description': 'What happened and how to get the version back.',
            'type': 'string',
          }),
          'version_id': dict({
            'type': 'integer',
          }),
        }),
        'required': list([
          'document_id',
          'version_id',
          'current_version_id',
          'message',
        ]),
        'type': 'object',
      }),
      'title': 'Delete document version',
    }),
