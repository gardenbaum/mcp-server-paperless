            'items': dict({
              'description': 'A share-link bundle: one URL for a ZIP archive of several documents.',
              'properties': dict({
                'built_at': dict({
                  'anyOf': list([
                    dict({
                      'format': 'date-time',
                      'type': 'string',
                    }),
                    dict({
