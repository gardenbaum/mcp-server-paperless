        'title': 'List groups',
      }),
      'description': '''
        List Paperless user groups as compact rows: id and name.
        
        Use it to find the group names and ids to pass to set_permissions. Like
        list_taxonomy(kind="group") it returns id and name only, but it pages and filters on the
        server. Needs the view_group permission in Paperless; without it, ask an administrator for
        the ids and pass them.
      ''',
      'inputSchema': dict({
        'additionalProperties': False,
        'properties': dict({
          'name_contains': dict({
            'anyOf': list([
              dict({
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Only groups whose name contains this text, ignoring case.',
          }),
          'page': dict({
            'default': 1,
            'description': 'Page number, from 1.',
            'minimum': 1,
            'type': 'integer',
          }),
          'page_size': dict({
            'default': 25,
            'description': 'Rows per page, at most 100.',
            'maximum': 100,
            'minimum': 1,
            'type': 'integer',
          }),
        }),
        'type': 'object',
      }),
      'name': 'list_groups',
      'outputSchema': dict({
        'description': 'One page of groups.',
        'properties': dict({
          'count': dict({
            'description': 'How many groups match in total.',
            'type': 'integer',
          }),
          'groups': dict({
            'items': dict({
              'description': 'A Paperless user group as a compact row (no permission list).',
              'properties': dict({
                'id': dict({
                  'type': 'integer',
                }),
                'name': dict({
                  'type': 'string',
                }),
              }),
              'required': list([
                'id',
                'name',
              ]),
              'type': 'object',
            }),
            'type': 'array',
          }),
          'next_page': dict({
            'anyOf': list([
              dict({
                'type': 'integer',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'description': 'The next page, null on the last one.',
          }),
          'page': dict({
            'type': 'integer',
          }),
        }),
        'required': list([
          'count',
          'page',
          'next_page',
          'groups',
        ]),
        'type': 'object',
      }),
      'title': 'List groups',
    }),
