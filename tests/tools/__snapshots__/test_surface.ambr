    dict({
      '_meta': dict({
        'fastmcp': dict({
          'tags': list([
            'trash',
          ]),
        }),
      }),
      'annotations': dict({
        'destructiveHint': True,
        'idempotentHint': False,
        'openWorldHint': False,
        'readOnlyHint': False,
        'title': 'Empty trash',
      }),
      'description': '''
        Delete trash entries for good: documents, their files, text, notes and metadata are lost.
        
        This cannot be undone. It never empties everything by default: name document_ids from
        list_trash, or a filter, or pass all=true for the whole trash, and in every case confirm.
        Without it a dialog, or an error for you to show the user, first lists the entries that would
        go: the first ten, then a count (see confirm). A filter lists every match (up to 100, newest
        deletion first) and needs the dialog: confirm=true does not count with it, so without a dialog
        pass the document_ids the error names, if it names any. With confirm=true, all=true empties
        whatever the trash holds then, which can differ from what was listed: when the trash holds at
        most 100 entries, list it and pass their ids as document_ids instead, so exactly the reviewed
        entries go.
        Only name what the user asked to delete; to get documents back, use restore_from_trash. All or
        none: Paperless checks all ids before it changes any; an id that is not in the trash is an
        error that names it. entries lists each one with what the trash showed afterwards, since
        Paperless also reports success when deleting failed. Needs the permission to delete documents
        and ownership of every document (or no owner).
      ''',
      'inputSchema': dict({
        'additionalProperties': False,
        'properties': dict({
          'all': dict({
            'default': False,
            'description': 'true: delete every entry in the trash for good. Use this, document_ids or filter.',
            'type': 'boolean',
          }),
          'confirm': dict({
            'default': False,
            'description': 'Must be true to go ahead at once. Without it a client that can show dialogs asks the user, and the tool runs only if they accept; with any other nothing changes and the error says what would happen. Describe that to the user and pass true only once they agree, or if they already asked for exactly this.',
            'type': 'boolean',
          }),
          'document_ids': dict({
            'anyOf': list([
              dict({
                'items': dict({
                  'minimum': 1,
                  'type': 'integer',
                }),
                'maxItems': 100,
                'minItems': 1,
                'type': 'array',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Entry ids from list_trash to delete for good; at most 100. Use this, filter or all, never two of them.',
          }),
          'filter': dict({
            'anyOf': list([
              dict({
                'additionalProperties': False,
                'description': 'Which entries of the trash; everything given has to match.',
                'properties': dict({
                  'deleted_from': dict({
                    'anyOf': list([
                      dict({
                        'format': 'date',
                        'type': 'string',
                      }),
                      dict({
                        'type': 'null',
                      }),
                    ]),
                    'default': None,
                    'description': 'Deleted on this day (UTC) or later.',
                  }),
                  'deleted_to': dict({
                    'anyOf': list([
                      dict({
                        'format': 'date',
                        'type': 'string',
                      }),
                      dict({
                        'type': 'null',
                      }),
                    ]),
                    'default': None,
                    'description': 'Deleted on this day (UTC) or earlier.',
                  }),
                  'document_type': dict({
                    'anyOf': list([
                      dict({
                        'anyOf': list([
                          dict({
                            'type': 'string',
                          }),
                          dict({
                            'type': 'integer',
                          }),
                        ]),
                      }),
                      dict({
                        'type': 'null',
                      }),
                    ]),
                    'default': None,
                    'description': "Document type by name or id (of a version: its document's).",
                  }),
                  'ids': dict({
                    'anyOf': list([
                      dict({
                        'items': dict({
                          'minimum': 1,
                          'type': 'integer',
                        }),
                        'maxItems': 100,
                        'minItems': 1,
                        'type': 'array',
                      }),
                      dict({
                        'type': 'null',
                      }),
                    ]),
                    'default': None,
                    'description': 'Only these entry ids.',
                  }),
                  'kind': dict({
                    'anyOf': list([
                      dict({
                        'enum': list([
                          'document',
                          'version',
                        ]),
                        'type': 'string',
                      }),
                      dict({
                        'type': 'null',
                      }),
                    ]),
                    'default': None,
                    'description': 'document, or version: a deleted version.',
                  }),
                  'title': dict({
                    'anyOf': list([
                      dict({
                        'minLength': 1,
                        'type': 'string',
                      }),
                      dict({
                        'type': 'null',
                      }),
                    ]),
                    'default': None,
                    'description': 'Part of the title, ignoring case.',
                  }),
                }),
                'type': 'object',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'The entries to find instead of document_ids, like the filters of list_trash. It shows them with their ids, so that you can pass these.',
          }),
        }),
        'type': 'object',
      }),
      'name': 'empty_trash',
      'outputSchema': dict({
