                    'type': 'string',
                  }),
                  dict({
                    'type': 'integer',
                  }),
                ]),
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'Username or id of the new owner; see list_users.',
          }),
          'view_groups': dict({
            'anyOf': list([
              dict({
                'items': dict({
                  'anyOf': list([
                    dict({
                      'type': 'string',
