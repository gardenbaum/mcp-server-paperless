                'checksum': dict({
                  'anyOf': list([
                    dict({
                      'type': 'string',
                    }),
                    dict({
                      'type': 'null',
                    }),
                  ]),
                  'default': None,
                  'description': 'SHA-256 of the file; two versions with the same checksum are copies.',
                }),
                'id': dict({
                  'type': 'integer',
                }),
                'is_root': dict({
                  'description': 'True for the original upload.',
                  'type': 'boolean',
                }),
                'version_label': dict({
                  'anyOf': list([
                    dict({
                      'type': 'string',
                    }),
                    dict({
                      'type': 'null',
                    }),
                  ]),
                }),
              }),
              'required': list([
                'id',
                'added',
                'version_label',
                'is_root',
              ]),
              'type': 'object',
            }),
            'type': 'array',
          }),
          'web_url': dict({
            'description': 'Link to the document in the Paperless web UI.',
            'type': 'string',
          }),
        }),
        'required': list([
          'document_id',
          'title',
          'current_version_id',
          'versions',
          'web_url',
        ]),
        'type': 'object',
