                  'starttls',
                ]),
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'ssl: TLS from the start (port 993); starttls (port 143); none: no encryption.',
          }),
          'imap_server': dict({
            'anyOf': list([
              dict({
                'maxLength': 256,
                'minLength': 1,
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'New IMAP host.',
          }),
          'name': dict({
            'anyOf': list([
              dict({
                'maxLength': 256,
                'minLength': 1,
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'New unique name.',
          }),
          'password': dict({
            'anyOf': list([
              dict({
                'description': 'The password of the mail account (or its app password), as text. Write-only: it is stored by Paperless and never shown again.',
                'format': 'password',
                'type': 'string',
                'writeOnly': True,
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'A new password; omit to keep it.',
