                'size_bytes': dict({
                  'anyOf': list([
                    dict({
                      'type': 'integer',
                    }),
                    dict({
                      'type': 'null',
                    }),
                  ]),
                  'description': 'The archive size once built.',
                }),
                'status': dict({
                  'description': 'pending or processing: Paperless is building the archive; ready: the URL works; failed: see last_error and call rebuild_share_bundle.',
