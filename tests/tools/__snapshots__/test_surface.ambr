                'maxItems': 50,
                'type': 'array',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'File names of its attachments; [] for none.',
          }),
          'folder': dict({
            'anyOf': list([
              dict({
                'maxLength': 256,
                'type': 'string',
              }),
