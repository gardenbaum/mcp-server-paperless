                        'minItems': 1,
                        'type': 'array',
                      }),
                      dict({
                        'type': 'null',
                      }),
                    ]),
                    'default': None,
                    'description': 'Only these entry ids.',
                  }),
                  'kind': dict({
                    'anyOf': list([
                      dict({
                        'enum': list([
                          'document',
                          'version',
                        ]),
                        'type': 'string',
                      }),
                      dict({
                        'type': 'null',
                      }),
                    ]),
                    'default': None,
                    'description': 'document, or version: a deleted version.',
                  }),
                  'title': dict({
                    'anyOf': list([
                      dict({
                        'minLength': 1,
                        'type': 'string',
                      }),
                      dict({
                        'type': 'null',
                      }),
                    ]),
                    'default': None,
                    'description': 'Part of the title, ignoring case.',
                  }),
                }),
                'type': 'object',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'The entries to find instead of document_ids, like the filters of list_trash. It shows them with their ids, so that you can pass these.',
