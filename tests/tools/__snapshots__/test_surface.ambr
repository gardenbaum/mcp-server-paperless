            'type': 'string',
          }),
          'document_id': dict({
            'type': 'integer',
          }),
          'next_offset': dict({
            'anyOf': list([
              dict({
                'type': 'integer',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'description': 'Offset of the next slice, null at the end of the text.',
          }),
          'offset': dict({
            'description': 'Where the slice starts, in characters.',
            'type': 'integer',
          }),
          'text_state': dict({
            'description': 'Fingerprint of the whole text of this version.',
            'type': 'string',
          }),
          'total_chars': dict({
            'description': 'Length of the whole text.',
            'type': 'integer',
          }),
