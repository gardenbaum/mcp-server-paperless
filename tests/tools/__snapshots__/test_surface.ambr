              'started',
              'success',
              'failure',
              'revoked',
            ]),
            'type': 'string',
          }),
          'task_id': dict({
            'type': 'string',
          }),
          'task_type': dict({
            'description': 'E.g. consume_file (an upload).',
            'type': 'string',
          }),
          'wait': dict({
