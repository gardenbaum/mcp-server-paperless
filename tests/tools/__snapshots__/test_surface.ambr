            'pattern': '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$',
            'type': 'string',
          }),
          'wait_seconds': dict({
            'default': 0,
            'description': 'Wait up to this many seconds for the task to end; more than 30 is cut to 30. 0 reads it once.',
            'minimum': 0,
            'type': 'integer',
          }),
        }),
        'required': list([
          'task_id',
        ]),
        'type': 'object',
      }),
      'name': 'get_task',
