            'anyOf': list([
              dict({
                'items': dict({
                  'maxLength': 256,
                  'type': 'string',
                }),
                'maxItems': 50,
                'type': 'array',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'File names of its attachments; [] for none.',
          }),
          'folder': dict({
            'anyOf': list([
              dict({
                'maxLength': 256,
                'type': 'string',
              }),
              dict({
                'type': 'null',
              }),
            ]),
            'default': None,
            'description': 'The IMAP folder the mail is in.',
          }),
          'is_flagged': dict({
            'anyOf': list([
              dict({
