# The part of PDFium's C interface the renderer and its tests use.

from ctypes import Array, Structure, c_ushort
from typing import Final

from pypdfium2 import PdfBitmap, PdfDocument, PdfFormEnv, PdfPage

FPDFBitmap_BGR: Final[int]
FPDF_ANNOT: Final[int]
FPDF_ANNOT_FILEATTACHMENT: Final[int]
FPDF_ANNOT_LINK: Final[int]
FPDF_ANNOT_STAMP: Final[int]
FPDF_ANNOT_TEXT: Final[int]
FPDF_ANNOT_WIDGET: Final[int]
FPDF_PAGEOBJ_FORM: Final[int]
FLAT_PRINT: Final[int]
FLATTEN_FAIL: Final[int]
FLATTEN_SUCCESS: Final[int]

class _Matrix(Structure):
    def __init__(
        self,
        a: float = ...,
        b: float = ...,
        c: float = ...,
        d: float = ...,
        e: float = ...,
        f: float = ...,
    ) -> None: ...

    a: float
    b: float
    c: float
    d: float

class _Rect(Structure):
    def __init__(
        self, left: float = ..., top: float = ..., right: float = ..., bottom: float = ...
    ) -> None: ...

    left: float
    top: float
    right: float
    bottom: float

FS_MATRIX = _Matrix
FS_RECTF = _Rect

