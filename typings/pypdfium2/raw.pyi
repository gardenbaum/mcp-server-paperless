def FPDFPageObj_GetClipPath(page_object: _Object) -> _ClipPath: ...
def FPDFClipPath_CountPaths(clip_path: _ClipPath) -> int: ...
def FPDF_NewXObjectFromPage(dest: PdfDocument, src: PdfDocument, index: int) -> _XObject: ...
def FPDF_NewFormObjectFromXObject(xobject: _XObject) -> _Object: ...
def FPDF_CloseXObject(xobject: _XObject) -> None: ...

class _Annotation: ...

def FPDFPage_GetAnnotCount(page: PdfPage) -> int: ...
