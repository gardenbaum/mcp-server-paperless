class _XObject: ...
class _ClipPath: ...

def FPDFPage_CountObjects(page: PdfPage) -> int: ...
def FPDFPage_GetObject(page: PdfPage, index: int) -> _Object: ...
def FPDFPage_RemoveObject(page: PdfPage, page_object: _Object) -> int: ...
def FPDFPage_GenerateContent(page: PdfPage) -> int: ...
def FPDFPage_Flatten(page: PdfPage, flags: int) -> int: ...
def FPDFPage_RemoveAnnot(page: PdfPage, index: int) -> int: ...
def FPDFPage_CreateAnnot(page: PdfPage, subtype: int) -> _Annotation: ...
def FPDFAnnot_GetFlags(annot: _Annotation) -> int: ...
def FPDFAnnot_SetFlags(annot: _Annotation, flags: int) -> int: ...
def FPDFAnnot_GetRect(annot: _Annotation, rect: _Rect) -> int: ...
def FPDFAnnot_SetAP(annot: _Annotation, mode: int, value: None) -> int: ...
def FPDFAnnot_SetStringValue(annot: _Annotation, key: bytes, value: Array[c_ushort]) -> int: ...
def FPDFAnnot_SetRect(annot: _Annotation, rect: _Rect) -> int: ...
def FPDFAnnot_AppendObject(annot: _Annotation, page_object: _Object) -> int: ...
def FPDFPageObj_Destroy(page_object: _Object) -> None: ...
def FPDFPageObj_GetType(page_object: _Object) -> int: ...
def FPDFPageObj_GetMatrix(page_object: _Object, matrix: _Matrix) -> int: ...
def FPDFPageObj_Transform(
    page_object: _Object, a: float, b: float, c: float, d: float, e: float, f: float
