# The part of pypdfium2 the renderer and its tests use (the package has no type hints).

from collections.abc import Iterator
from io import BytesIO

from PIL import Image
from pypdfium2 import raw as raw

class PdfiumError(Exception):
    err_code: int | None

class _Info:
    flags: tuple[str, ...]

PDFIUM_INFO: _Info

class PdfFormEnv: ...

class PdfPage:
    formenv: PdfFormEnv | None
    def get_size(self) -> tuple[float, float]: ...
    def get_rotation(self) -> int: ...
    def set_rotation(self, rotation: int) -> None: ...
    def get_cropbox(self) -> tuple[float, float, float, float]: ...
    def set_cropbox(self, l: float, b: float, r: float, t: float) -> None: ...
    def close(self) -> None: ...

class PdfBitmap:
    @classmethod
    def new_native(cls, width: int, height: int, format: int) -> PdfBitmap: ...
    def fill_rect(
        self, color: tuple[int, int, int, int], left: int, top: int, width: int, height: int
    ) -> None: ...
    def to_pil(self) -> Image.Image: ...

class PdfDocument:
    def __init__(self, input: bytes) -> None: ...
    def init_forms(self) -> bool: ...
    def __len__(self) -> int: ...
    def __getitem__(self, i: int) -> PdfPage: ...
    def new_page(self, width: float, height: float, index: int) -> PdfPage: ...
    def close(self) -> None: ...
    def get_page_size(self, index: int) -> tuple[float, float]: ...
    def import_pages(self, pdf: PdfDocument, pages: list[int], index: int) -> None: ...
    def save(self, dest: BytesIO) -> None: ...
    def get_formtype(self) -> int: ...
    def get_toc(self) -> Iterator[object]: ...
